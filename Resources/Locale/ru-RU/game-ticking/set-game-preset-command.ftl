set-game-preset-command-description = Устанавливает игровой пресет на указанное количество предстоящих раундов. Также может отображать название и описание другого пресета в лобби, чтобы обмануть игроков.
set-game-preset-command-help-text = setgamepreset <id> [number of rounds, defaulting to 1] [decoy preset]
set-game-preset-command-hint-1 = <id>
set-game-preset-command-hint-2 = [number of rounds]
set-game-preset-command-hint-3 = [decoy preset]

set-game-preset-optional-argument-not-integer = Если указан второй аргумент, он должен быть числом.
set-game-preset-preset-error = Не удаётся найти игровой пресет «{$preset}»
set-game-preset-decoy-error = Если указан третий аргумент, он должен быть действительным пресетом. Не удаётся найти игровой пресет «{$preset}»

#set-game-preset-preset-set = Игровой пресет установлен на «{$preset}»
set-game-preset-preset-set-finite = Игровой пресет установлен на «{$preset}» на следующие {$rounds} раундов.
set-game-preset-preset-set-finite-with-decoy = Игровой пресет установлен на «{$preset}» на следующие {$rounds} раундов, отображая в лобби «{$decoy}».
